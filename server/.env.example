# Copy this file to .env and fill in real values. Never commit .env to git.

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/quizapp

# Port the server listens on
PORT=5000

# Secret used to sign admin JWTs - make this long and random in production
JWT_SECRET=change_this_to_a_long_random_string

# How long an admin login token stays valid
JWT_EXPIRES_IN=7d

# Comma separated list of origins allowed to call the API / connect sockets from.
# In local dev, the server also serves the frontend itself, so this can just be "*".
CLIENT_ORIGIN=*
